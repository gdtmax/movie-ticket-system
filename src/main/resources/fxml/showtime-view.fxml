<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="edu.nyu.cs6103.movietickets.client.controller.ShowtimeController">
 <top><HBox alignment="CENTER_LEFT" spacing="14" styleClass="toolbar"><Button text="← Movies" styleClass="secondary-button" onAction="#back"/><Label fx:id="movieLabel" styleClass="page-title"/></HBox></top>
 <center><VBox spacing="14"><Label text="Select a date and time" styleClass="muted-text"/><ListView fx:id="showtimeList" VBox.vgrow="ALWAYS"/><Label fx:id="statusLabel" styleClass="status-text"/><Button text="Choose Seats" onAction="#selectSeats"/></VBox></center>
 <padding><Insets top="24" right="32" bottom="28" left="32"/></padding>
</BorderPane>
